# ── NOTE FOR WORDPRESS SITES ──────────────────────────────────────────────
# When you deploy wp-cleaner.php to a WordPress root, add it to THAT
# site's .gitignore so it doesn't get committed to the site repo:
#   echo "wp-cleaner.php" >> /path/to/wordpressroot/.gitignore
# ──────────────────────────────────────────────────────────────────────────

# Cache & backup directories (generated at runtime)
wp-cleaner-cache/
wp-cleaner-backup/
docs/

# Generated reports
wp-cleaner-report-*.html

# Log files
*.log

# OS
.DS_Store
Thumbs.db
